# Copy to .env and replace placeholders. Never commit .env.

# PostgreSQL (docker-compose.yml uses these defaults for local dev)
POSTGRES_USER=dentflex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dentflex
DATABASE_URL=postgresql://dentflex:change-me@localhost:5432/dentflex
# Separate database used by `npm test` integration tests (created automatically if missing)
TEST_DATABASE_URL=postgresql://dentflex:change-me@localhost:5432/dentflex_test

# Public base URL (used for unsubscribe links). HTTPS in production.
APP_BASE_URL=http://localhost:3000

# Secret used to sign unsubscribe links and the idempotency fingerprint. 32+ random chars.
APP_SECRET=replace-with-a-long-random-string

# Clinic timezone used to render times and schedule automation
CLINIC_TIMEZONE=Europe/Istanbul

# AI coordinator chat provider: "deepseek" or "openai". With no working key the assistant runs
# a clearly-labelled scripted sales flow (same tools and data), and also falls back to it if the
# provider errors (e.g. out of credit).
CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# OpenAI — used for natural voice (text-to-speech), and for chat when CHAT_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_FEMALE=shimmer
OPENAI_TTS_VOICE_MALE=onyx
# Cost-estimate rates (USD) from the providers' live pricing pages; 0 = not configured.
AI_TEXT_INPUT_USD_PER_1M=0
AI_TEXT_OUTPUT_USD_PER_1M=0
AI_TTS_USD_PER_1M_CHARS=0
# Phone-style voice calls (OpenAI Realtime speech-to-speech). Calls end at VOICE_MAX_SESSION_SECONDS.
VOICE_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
VOICE_MAX_SESSION_SECONDS=300
# Budget guardrails (estimated USD). Assistant/voice endpoints refuse new sessions above these.
AI_DAILY_BUDGET_USD=10
AI_MONTHLY_BUDGET_USD=200

# Messaging providers — "console" logs a redacted message instead of sending.
EMAIL_PROVIDER=console
EMAIL_FROM="Dent Flex <no-reply@example.invalid>"
WHATSAPP_PROVIDER=console
# Shared secret used to verify provider webhooks (HMAC-SHA256 of the raw body)
PROVIDER_WEBHOOK_SECRET=replace-me

# Initial admin created by `npm run db:seed` (demo only; change immediately)
SEED_ADMIN_EMAIL=admin@dentflex.local
SEED_ADMIN_PASSWORD=ChangeMe-Demo-Only-123
